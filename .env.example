# ──────────────────────────────────────────────────────────────────────────────
# Finolio – Environment Configuration
# Copy this file to .env and fill in your Zerodha Kite Connect credentials
# ──────────────────────────────────────────────────────────────────────────────

# Zerodha Kite Connect Credentials (Required)
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here

# Server Configuration (Optional)
APP_ENV=development
LOG_LEVEL=info
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
STATIC_DIR=web/dist
DB_FILE=/data/finolio.db

